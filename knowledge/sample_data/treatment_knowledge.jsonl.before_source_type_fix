{"knowledge_id": "web-apple-scab-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "apple_scab", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Apple Scab - IPM Management", "content": "Reduce primary inoculum by managing fallen leaves and monitor spring wetness and infection periods. Protect young leaves and fruit when conditions favor infection; treatment timing and full coverage are important. Organic options described by UC IPM include lime sulfur, sulfur, and approved fixed copper products. Always use products according to the current local label."}
{"knowledge_id": "web-apple-scab-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "apple_scab", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Apple Scab - Conventional Management", "content": "Use a locally registered conventional fungicide program timed to infection periods, with thorough coverage of young foliage and fruit. Rotate fungicide modes of action and follow the current product label."}
{"knowledge_id": "web-black-rot-apple-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "black_rot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Apple Black Rot - IPM Management", "content": "Use sanitation and orchard monitoring to reduce disease pressure, remove affected plant material where practical, and manage environmental conditions that favor fruit and limb infection. Pruning and removal of diseased material are important components of integrated management. Use locally approved treatments when monitoring indicates they are needed."}
{"knowledge_id": "web-black-rot-apple-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "black_rot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Apple Black Rot - Conventional Management", "content": "Use sanitation and pruning to remove diseased fruit and wood where practical. Where disease risk warrants treatment, use a locally registered fungicide according to label timing and resistance-management guidance."}
{"knowledge_id": "web-cedar-apple-rust-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "cedar_apple_rust", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Cedar-Apple Rust - IPM Management", "content": "Monitor susceptible new growth and fruit during periods favorable for rust development. Reduce disease pressure by selecting less-susceptible cultivars where available and managing nearby alternate hosts where practical. Use locally approved fungicide protection when disease risk warrants it and follow the current product label."}
{"knowledge_id": "web-cedar-apple-rust-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Apple", "disease": "cedar_apple_rust", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Cedar-Apple Rust - Conventional Management", "content": "Monitor during infection-favorable periods and use less-susceptible cultivars where available. Where treatment is needed, use a locally registered fungicide according to crop stage, label directions, and resistance-management guidance."}
{"knowledge_id": "web-powdery-cherry-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Cherry", "disease": "powdery_mildew", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Cherry Powdery Mildew - IPM Management", "content": "Monitor new growth for powdery symptoms and reduce conditions that favor disease by maintaining good airflow and avoiding excessive nitrogen. Remove severely affected material where practical. When treatment is needed, use a locally approved powdery-mildew management option according to its label."}
{"knowledge_id": "web-powdery-cherry-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Cherry", "disease": "powdery_mildew", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Cherry Powdery Mildew - Conventional Management", "content": "Maintain good canopy airflow and avoid excessive nitrogen. If disease pressure warrants treatment, use a locally registered powdery-mildew fungicide and rotate modes of action according to the label."}
{"knowledge_id": "web-corn-cercospora-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "cercospora_leaf_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Corn Cercospora Leaf Spot - IPM Management", "content": "Scout fields regularly and use resistant hybrids where available. Reduce disease carryover by managing infected corn residue and using crop rotation where appropriate. Fungicide decisions should be based on disease severity, crop stage, weather risk, and locally approved recommendations."}
{"knowledge_id": "web-corn-cercospora-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "cercospora_leaf_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Corn Cercospora Leaf Spot - Conventional Management", "content": "Use resistant hybrids where available, manage infected residue, and rotate crops where practical. If treatment is warranted, use a locally registered fungicide at the recommended crop stage."}
{"knowledge_id": "web-corn-rust-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "common_rust", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Corn Common Rust - IPM Management", "content": "Use resistant corn hybrids as the primary management measure. Scout for rust pustules, especially during cool, wet conditions. Fungicides can be beneficial when disease risk is high and applications are made early; use only locally approved products and current label directions."}
{"knowledge_id": "web-corn-rust-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "common_rust", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Corn Common Rust - Conventional Management", "content": "Use resistant hybrids as the primary measure. Fungicides can be beneficial when disease develops early and conditions favor spread; use a locally registered product according to the current label."}
{"knowledge_id": "web-northern-leaf-blight-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "northern_leaf_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Northern Leaf Blight - IPM Management", "content": "Use resistant hybrids where available. Crop rotation and tillage can help reduce inoculum from infected corn residue. Monitor lower leaves and disease-favorable periods; where fungicides are warranted, timing should be based on crop stage, symptoms, and local recommendations."}
{"knowledge_id": "web-northern-leaf-blight-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Corn", "disease": "northern_leaf_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Northern Leaf Blight - Conventional Management", "content": "Use resistant hybrids and reduce inoculum through crop rotation and residue management. Where disease risk warrants treatment, use a locally registered fungicide according to crop stage and label directions."}
{"knowledge_id": "web-grape-black-rot-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "black_rot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Grape Black Rot - IPM Management", "content": "Maintain vineyard sanitation by removing infected fruit and other disease sources where practical. Monitor vines during periods favorable for infection and maintain an open canopy to improve drying and coverage. Use locally approved fungicide protection when risk is high and follow current label directions."}
{"knowledge_id": "web-grape-black-rot-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "black_rot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Grape Black Rot - Conventional Management", "content": "Remove infected fruit and plant material where practical and maintain an open canopy. Use locally registered fungicides when disease risk is high, following current label and resistance-management guidance."}
{"knowledge_id": "web-grape-esca-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "esca", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Grape Esca - IPM Management", "content": "Monitor vines for chronic decline and symptomatic shoots or leaves. Remove and manage severely affected vine material where appropriate and maintain sound pruning and vineyard sanitation practices. Management is primarily preventive and cultural; use locally recommended practices for affected vineyards."}
{"knowledge_id": "web-grape-esca-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "esca", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Grape Esca - Conventional Management", "content": "Management is primarily preventive and cultural. Remove severely affected material where appropriate, maintain sound pruning practices, and follow local extension recommendations; there is no single curative fungicide program for established esca."}
{"knowledge_id": "web-grape-leaf-blight-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "leaf_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Grape Leaf Blight - IPM Management", "content": "Scout vines regularly and reduce disease-favorable humidity and prolonged leaf wetness through canopy management. Remove affected material where practical and maintain vineyard sanitation. If chemical protection is needed, select a locally registered treatment based on the confirmed disease and follow the current label."}
{"knowledge_id": "web-grape-leaf-blight-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Grape", "disease": "leaf_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Grape Leaf Blight - Conventional Management", "content": "Improve canopy airflow and reduce prolonged leaf wetness. If chemical protection is required after diagnosis, use a locally registered fungicide appropriate for the confirmed disease."}
{"knowledge_id": "web-orange-greening-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Orange", "disease": "citrus_greening", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Citrus Greening - IPM Management", "content": "Use certified disease-free planting material and monitor trees regularly for symptoms and vector activity. Remove infected trees where required by local disease-management programs and manage the insect vector according to local recommendations. Because citrus greening management is region-specific, follow current local regulatory and extension guidance."}
{"knowledge_id": "web-orange-greening-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Orange", "disease": "citrus_greening", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Citrus Greening - Conventional Management", "content": "Use certified disease-free planting material, monitor trees and psyllid vectors, and follow local regulatory requirements for removal of infected trees. Manage vectors using currently registered products and regional recommendations."}
{"knowledge_id": "web-peach-bacterial-spot-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Peach", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Peach Bacterial Spot - IPM Management", "content": "Use less-susceptible cultivars where available, maintain good orchard sanitation, and avoid practices that spread bacterial inoculum. Monitor leaves and fruit during warm, wet conditions. Where protective treatments are recommended locally, use only registered products and follow current label directions."}
{"knowledge_id": "web-peach-bacterial-spot-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Peach", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Peach Bacterial Spot - Conventional Management", "content": "Use less-susceptible cultivars where available and maintain orchard sanitation. Where protective bactericides are locally recommended, use currently registered products according to label timing and directions."}
{"knowledge_id": "web-pepper-bacterial-spot-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Pepper", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Pepper Bacterial Spot - IPM Management", "content": "Use pathogen-free seed and disease-free transplants when possible. Avoid sprinkler irrigation and reduce splash and mechanical spread; rotate with nonhost crops where practical. Copper-based protectants may provide partial control where locally registered, but resistance can occur, so follow local IPM recommendations and current labels."}
{"knowledge_id": "web-pepper-bacterial-spot-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Pepper", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Pepper Bacterial Spot - Conventional Management", "content": "Use pathogen-free seed and transplants, avoid overhead irrigation, and rotate with nonhost crops. Copper-based bactericides provide partial control; use registered products according to the current label."}
{"knowledge_id": "web-potato-early-blight-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Potato", "disease": "early_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Potato Early Blight - IPM Management", "content": "Maintain optimum crop growth through appropriate fertility and irrigation and monitor routinely for symptoms. Use longer-season or less-susceptible varieties where suitable. When disease develops early enough to threaten yield, locally approved fungicide protection may be justified and should follow current label directions."}
{"knowledge_id": "web-potato-early-blight-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Potato", "disease": "early_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Potato Early Blight - Conventional Management", "content": "Maintain plant vigor and scout routinely. When disease pressure warrants protection, use a locally registered fungicide program and rotate modes of action according to current resistance-management guidance."}
{"knowledge_id": "web-potato-late-blight-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Potato", "disease": "late_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Potato Late Blight - IPM Management", "content": "Use certified healthy seed, monitor fields and weather for late-blight risk, and remove volunteer potatoes and other sources of inoculum where practical. Protect foliage preventively when risk is high using locally registered products and rotate modes of action according to resistance-management guidance."}
{"knowledge_id": "web-potato-late-blight-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Potato", "disease": "late_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Potato Late Blight - Conventional Management", "content": "Use certified healthy seed and remove volunteer potatoes and other inoculum sources. Monitor weather and disease risk closely and use protectant fungicides when risk is high, following local labels and resistance-management guidance."}
{"knowledge_id": "web-strawberry-leaf-scorch-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Strawberry", "disease": "leaf_scorch", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Strawberry Leaf Scorch - IPM Management", "content": "Confirm the diagnosis before treatment because several strawberry leaf diseases can produce similar symptoms. Maintain plant vigor, remove severely affected leaves where practical, improve field sanitation, and avoid conditions that prolong leaf wetness. Use locally recommended disease-management measures after diagnosis."}
{"knowledge_id": "web-strawberry-leaf-scorch-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Strawberry", "disease": "leaf_scorch", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Strawberry Leaf Scorch - Conventional Management", "content": "Confirm the diagnosis before treatment. Maintain plant vigor and sanitation; after confirmation, use a locally registered fungicide only where recommended for the diagnosed disease and follow the current label."}
{"knowledge_id": "web-tomato-bacterial-spot-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Bacterial Spot - IPM Management", "content": "Use pathogen-free seed and disease-free transplants when possible. Avoid sprinkler irrigation, remove nearby cull piles, and rotate with nonhost crops. Copper-containing bactericides can provide partial control when applied preventively; resistance may occur, so follow local IPM guidance and current labels."}
{"knowledge_id": "web-tomato-bacterial-spot-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "bacterial_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Bacterial Spot - Conventional Management", "content": "Use pathogen-free seed and transplants, avoid sprinkler irrigation, remove cull piles, and rotate crops. Copper bactericides provide partial control; use registered products and current resistance-management guidance."}
{"knowledge_id": "web-tomato-early-blight-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "early_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Early Blight - IPM Management", "content": "Use disease-free transplants, maintain plant vigor, improve air circulation, and avoid prolonged leaf wetness. Scout routinely and remove affected plant material where practical. When disease pressure warrants treatment, use locally approved fungicides according to current label directions and resistance-management guidance."}
{"knowledge_id": "web-tomato-early-blight-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "early_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Early Blight - Conventional Management", "content": "Manage volunteer tomato, potato, and nightshade hosts and rotate crops. When favorable conditions and symptoms indicate treatment, use a locally registered fungicide according to the label."}
{"knowledge_id": "web-tomato-late-blight-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "late_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Late Blight - IPM Management", "content": "Monitor weather and plants closely because late blight can develop rapidly under favorable conditions. Remove volunteer tomatoes and infected plant material where practical and avoid practices that prolong leaf wetness. Use preventive, locally registered fungicide protection when risk is high and rotate modes of action according to current guidance."}
{"knowledge_id": "web-tomato-late-blight-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "late_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Late Blight - Conventional Management", "content": "Remove volunteer tomato and potato plants and avoid overhead irrigation where possible. Apply protectant fungicides before disease development when risk is high and maintain thorough coverage according to local label directions."}
{"knowledge_id": "web-tomato-leaf-mold-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "leaf_mold", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Leaf Mold - IPM Management", "content": "Reduce humidity and leaf wetness through ventilation, spacing, canopy management, and careful irrigation. Remove infected leaves and plant debris where practical and use disease-free transplants. If treatment is needed, use a locally approved product according to its current label."}
{"knowledge_id": "web-tomato-leaf-mold-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "leaf_mold", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Leaf Mold - Conventional Management", "content": "Reduce humidity and leaf wetness through ventilation, spacing, canopy management, and careful irrigation. If treatment is required, use a locally registered fungicide according to the current label."}
{"knowledge_id": "web-tomato-mosaic-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "mosaic_virus", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Mosaic Virus - IPM Management", "content": "There is no curative treatment for an infected plant. Use clean seed and transplants, remove symptomatic plants when appropriate, control weeds that can host viruses, and disinfect hands and tools to reduce mechanical spread. Select resistant varieties where available and follow local extension recommendations."}
{"knowledge_id": "web-tomato-mosaic-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "mosaic_virus", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Mosaic Virus - Conventional Management", "content": "There is no curative fungicide for infected plants. Use clean seed and transplants, remove symptomatic plants where appropriate, disinfect tools, manage weed hosts, and use resistant varieties where available."}
{"knowledge_id": "web-tomato-septoria-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "septoria_leaf_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Septoria Leaf Spot - IPM Management", "content": "Remove infected leaves and plant debris where practical and improve airflow around plants. Avoid overhead irrigation and reduce leaf wetness. Use disease-free transplants and rotate crops where feasible; locally approved protectant fungicides may be used when disease pressure warrants treatment."}
{"knowledge_id": "web-tomato-septoria-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "septoria_leaf_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Septoria Leaf Spot - Conventional Management", "content": "Remove infected leaves and debris where practical, improve airflow, and avoid overhead irrigation. When disease pressure warrants treatment, use a locally registered protectant fungicide according to the label."}
{"knowledge_id": "web-tomato-spider-mites-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "spider_mites", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Spider Mites - IPM Management", "content": "Scout plants regularly and confirm mites before treatment. Avoid unnecessary broad-spectrum insecticides that can disrupt natural enemies, and reduce plant stress from dust or water shortage. Use biological and cultural controls where practical; if treatment is needed, choose a locally registered miticide based on monitoring and follow the current label."}
{"knowledge_id": "web-tomato-spider-mites-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "spider_mites", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Spider Mites - Conventional Management", "content": "Scout and confirm mites before treatment. Avoid unnecessary broad-spectrum insecticides that destroy natural enemies. If treatment is justified, use a locally registered miticide according to the label."}
{"knowledge_id": "web-tomato-target-spot-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "target_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Target Spot - IPM Management", "content": "Scout foliage and fruit regularly, improve canopy airflow, and avoid prolonged leaf wetness. Remove diseased plant material and manage crop debris where practical. When disease risk is significant, use a locally approved fungicide program and rotate modes of action according to current resistance-management guidance."}
{"knowledge_id": "web-tomato-target-spot-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "target_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Target Spot - Conventional Management", "content": "Improve canopy airflow and reduce prolonged leaf wetness. Remove diseased material where practical. When risk is significant, use a locally registered fungicide and rotate modes of action."}
{"knowledge_id": "web-tomato-yellow-leaf-curl-001", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "yellow_leaf_curl_virus", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Tomato Yellow Leaf Curl Virus - IPM Management", "content": "Use TYLCV-resistant varieties and virus-free, whitefly-free transplants. Manage whiteflies and weeds, avoid establishing new fields beside older infected fields where practical, and rogue infected plants when incidence is low. Follow current local extension and regulatory guidance for vector and disease management."}
{"knowledge_id": "web-tomato-yellow-leaf-curl-002", "source": "UC IPM", "source_type": "web_agricultural_guidance", "crop": "Tomato", "disease": "yellow_leaf_curl_virus", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Tomato Yellow Leaf Curl Virus - Conventional Management", "content": "Use resistant varieties and virus-free transplants where available. Manage whitefly vectors and weed hosts according to local recommendations; vector control does not cure infected plants."}
{"knowledge_id": "web-rice-blb-001", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "bacterial_leaf_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Rice Bacterial Leaf Blight - IPM Management", "content": "Use disease-free seed and avoid excessive nitrogen. Avoid field operations when plants are wet because moisture can aid spread. TNAU guidance includes locally recommended copper-based and other treatments for disease onset; use only currently registered products and follow current Tamil Nadu or local agricultural recommendations."}
{"knowledge_id": "web-rice-blb-002", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "bacterial_leaf_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Rice Bacterial Leaf Blight - Conventional Management", "content": "Use disease-free seed and balanced nitrogen management. Monitor from early symptoms; where chemical intervention is locally recommended, use only currently registered products according to current regional agricultural guidance."}
{"knowledge_id": "web-rice-brown-spot-001", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "brown_spot", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Rice Brown Spot - IPM Management", "content": "Use healthy seed and maintain balanced crop nutrition and field management. Monitor for brown leaf spots, particularly under conditions favorable to disease. TNAU provides seed-treatment and fungicide-management recommendations; use only currently registered products and follow the current local label."}
{"knowledge_id": "web-rice-brown-spot-002", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "brown_spot", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Rice Brown Spot - Conventional Management", "content": "Use healthy seed and balanced crop nutrition. Monitor for symptoms and, where fungicide treatment is locally recommended, use a currently registered product according to the label."}
{"knowledge_id": "web-rice-leaf-blast-001", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "leaf_blast", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Rice Leaf Blast - IPM Management", "content": "Avoid excessive nitrogen and maintain appropriate water management and drainage. Monitor crops during humid, wet conditions and at high-risk growth stages. TNAU guidance includes locally recommended fungicide options for blast; use only currently registered products and follow current local recommendations."}
{"knowledge_id": "web-rice-leaf-blast-002", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "leaf_blast", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Rice Leaf Blast - Conventional Management", "content": "Avoid excessive nitrogen and manage water appropriately. Monitor during humid and wet periods; where treatment is warranted, use a locally registered blast-management product according to current regional recommendations."}
{"knowledge_id": "web-rice-scald-001", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "scald", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Rice Scald - IPM Management", "content": "Monitor rice fields for scald symptoms and manage crop conditions that favor prolonged humidity and leaf wetness. Maintain balanced nutrition and field sanitation, and use locally recommended disease-management measures when symptoms are confirmed. Treatment should follow current regional agricultural guidance and product labels."}
{"knowledge_id": "web-rice-scald-002", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "scald", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Rice Scald - Conventional Management", "content": "Manage conditions that favor prolonged humidity and leaf wetness and maintain balanced nutrition and sanitation. If treatment is required after diagnosis, use a locally registered product according to regional guidance."}
{"knowledge_id": "web-rice-sheath-blight-001", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "sheath_blight", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Rice Sheath Blight - IPM Management", "content": "Reduce excessive nitrogen and manage dense crop canopies and field conditions that favor high humidity. Monitor from tillering onward. TNAU guidance includes locally recommended fungicide options; use only currently registered products and follow current local label and extension recommendations."}
{"knowledge_id": "web-rice-sheath-blight-002", "source": "TNAU", "source_type": "web_agricultural_guidance", "crop": "Rice", "disease": "sheath_blight", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Rice Sheath Blight - Conventional Management", "content": "Avoid excessive nitrogen and manage dense canopies and high-humidity conditions. Scout from tillering onward and use a locally registered fungicide when justified by local recommendations."}
{"knowledge_id": "web-squash-powdery-001", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Squash", "disease": "powdery_mildew", "evidence_type": "treatment", "recommendation_preference": "IPM", "organic_eligible": true, "ipm_eligible": true, "title": "Squash Powdery Mildew - IPM Management", "content": "Grow resistant varieties where available, maintain good airflow, and monitor leaves regularly for early symptoms. Avoid excessive nitrogen and remove severely affected material where practical. When treatment is necessary, use a locally approved powdery-mildew product according to its current label."}
{"knowledge_id": "web-squash-powdery-002", "source": "UMN Extension", "source_type": "web_agricultural_guidance", "crop": "Squash", "disease": "powdery_mildew", "evidence_type": "treatment", "recommendation_preference": "General", "organic_eligible": false, "ipm_eligible": true, "title": "Squash Powdery Mildew - Conventional Management", "content": "Use resistant varieties where available, maintain good airflow, and monitor leaves regularly. If disease pressure warrants treatment, use a locally registered powdery-mildew fungicide according to the current label and resistance-management guidance."}
